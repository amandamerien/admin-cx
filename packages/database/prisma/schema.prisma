generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────
// Modelos do Better Auth
//
// Gerados/atualizados por `pnpm auth:generate` a partir da config em
// apps/api/src/modules/better-auth/configs.ts. Ao adicionar plugins
// (admin, organization, 2FA...) ou campos extras, rode `pnpm auth:generate`
// e depois `pnpm db:migrate`.
// ──────────────────────────────────────────────────────────────

model Users {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Sessions[]
  accounts      Accounts[]
  administrador Administrador?
  acessos       AcessoEquipe[]

  @@map("users")
}

model Sessions {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  users     Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Accounts {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  users                 Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ──────────────────────────────────────────────────────────────
// Painel de clientes
//
// Os enums repetem, com os mesmos valores, as listas `as const` de
// apps/app/src/features/clientes/dados.ts — os rótulos e as cores de cada
// valor continuam do lado da tela; aqui fica só o domínio.
// ──────────────────────────────────────────────────────────────

enum StatusCliente {
  ativo
  onboarding
  em_risco
  inativo
}

/// Plano que o cliente assina na Clickmax.
enum PlanoCliente {
  growth
  profissional
  business
}

/// Periodicidade da cobrança do plano.
enum CicloPlano {
  mensal
  anual
}

enum ColunaPipeline {
  nao_iniciado
  em_andamento
  aguardando_cliente
  em_revisao
  bloqueado
  concluido
}

enum EtapaFunil {
  onboarding
  briefing_diagnostico
  estrategia
  copy
  design
  construcao_funil
  pipeline
  automacoes
  testes_revisao
  publicacao
}

enum TipoArquivo {
  drive
  docs
  sheets
  slides
  figma
  notion
  canva
  dropbox
  loom
  claude
  outro
}

enum Papel {
  administrador
  editor
  visualizador
}

enum AvatarId {
  estrela
  espinho
  losango
  capsula
  gota
  coracao
  bolha
}

enum GrupoChecklist {
  base
  produtos
  publico
  empresa
  paginas
  campanhas
  ferramentas
  objetivo
}

enum TipoAnotacao {
  postit
  emoji
  comentario
}

enum CorAnotacao {
  amarelo
  rosa
  azul
  verde
  roxo
  laranja
}

/// O que aconteceu no painel: uma linha por ação que vale contar aos outros.
///
/// O nome do autor fica copiado aqui, como no log de acessos: se a pessoa sair
/// da equipe, o histórico continua legível.
model Atividade {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autorId   String?        @db.Uuid
  autor     Administrador? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNome String
  /// O que foi feito: `cliente_criado`, `entrega_criada`, e por aí.
  acao      String
  /// Sobre o quê: o nome do cliente, da entrega, do invoice.
  alvo      String
  /// Complemento quando a ação pede — o status novo, por exemplo.
  detalhe   String?
  criadoEm  DateTime       @default(now())

  @@index([criadoEm])
  @@map("atividades")
}

/// Invoice emitido pelo painel.
///
/// Não tem vínculo com `Cliente` de propósito: serve para emitir em nome de
/// quem for, inclusive de quem não está na carteira. O que identifica o
/// destinatário é o que foi digitado na hora.
model Invoice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero    String
  /// Data que sai impressa no documento.
  data      DateTime @db.Date
  nome      String
  cpf       String
  email     String
  telefone  String
  endereco  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens ItemInvoice[]

  @@index([createdAt])
  @@map("invoices")
}

/// Linha da descrição do invoice.
model ItemInvoice {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId  String  @db.Uuid
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fornecedor String
  /// Texto livre: cabe "2" e cabe "2 meses".
  quantidade String
  /// Valor total da linha, em reais.
  valor      Decimal @db.Decimal(12, 2)
  /// Posição na lista, para o documento sair sempre na mesma ordem.
  ordem      Int

  @@index([invoiceId])
  @@map("itens_invoice")
}

/// Uma entrada no painel: uma linha por login, gravada no momento em que a
/// pessoa entra.
///
/// Separado das sessões do Better Auth de propósito — aquela tabela guarda só
/// as sessões vivas, então some quando a pessoa sai ou a sessão expira, e o
/// histórico de acessos se perderia. Nome e e-mail ficam copiados aqui para o
/// registro continuar legível se a conta for excluída depois.
model AcessoEquipe {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  user      Users?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  nome      String
  email     String
  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now())

  @@index([criadoEm])
  @@index([userId])
  @@map("acessos_equipe")
}

/// Pessoa do time Clickmax. `userId` liga a ficha à conta do Better Auth —
/// fica nulo enquanto a pessoa está na equipe mas ainda sem acesso, que é o
/// mesmo que o `email: null` fazia na tela.
model Administrador {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  cargo     String
  email     String?  @unique
  papel     Papel    @default(visualizador)
  ativo     Boolean  @default(true)
  avatar    AvatarId @default(estrela)
  userId    String?  @unique @db.Uuid
  user      Users?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas      NotaCliente[]
  anotacoes  Anotacao[]
  atividades Atividade[]

  @@map("administradores")
}

/// Cliente em construção de funil com o time.
model Cliente {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String
  email            String
  status           StatusCliente @default(onboarding)
  /// Plano e ciclo ficam opcionais: os clientes cadastrados antes desta
  /// coluna existirem não têm plano registrado, e chutar um deles seria
  /// inventar dado comercial.
  plano            PlanoCliente?
  cicloPlano       CicloPlano?
  /// Quantas entregas o cliente contratou. Serve de meta: a ficha compara o
  /// que foi concluído com este número.
  funisContratados Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  funis     Funil[]
  arquivos  ArquivoCliente[]
  acessos   AcessoCliente[]
  notas     NotaCliente[]
  checklist ItemChecklist[]

  @@index([status])
  @@map("clientes")
}

/// Funil de um cliente: em que etapa está e em que coluna do pipeline aparece.
model Funil {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId    String         @db.Uuid
  cliente      Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome         String
  etapa        EtapaFunil     @default(onboarding)
  status       ColunaPipeline @default(nao_iniciado)
  /// Quem do time responde pela entrega, pelos nomes — a ficha da pessoa pode
  /// sair da equipe sem levar o histórico junto. Lista porque uma entrega pode
  /// ser tocada a mais de uma mão.
  responsaveis String[]
  /// Data de entrega prevista; nulo enquanto não há data combinada.
  dataEntrega  DateTime?      @db.Date
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([clienteId])
  @@index([status])
  @@map("funis")
}

/// Link de material do cliente (Drive, Figma, Notion...).
model ArquivoCliente {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId String      @db.Uuid
  cliente   Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo      TipoArquivo
  /// Como o arquivo é chamado na conversa: o rótulo do tipo, ou o que a pessoa
  /// digitou quando o tipo é "outro".
  nome      String
  url       String
  createdAt DateTime    @default(now())

  @@index([clienteId])
  @@map("arquivos_cliente")
}

/// Acesso de plataforma que o cliente entregou ao time.
model AcessoCliente {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId  String   @db.Uuid
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plataforma String
  email      String
  senha      String
  url        String?
  createdAt  DateTime @default(now())

  @@index([clienteId])
  @@map("acessos_cliente")
}

/// Recado preso à ficha do cliente.
model NotaCliente {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId  String         @db.Uuid
  cliente    Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  autorId    String?        @db.Uuid
  autorFicha Administrador? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  /// O nome vai junto para a nota não ficar sem assinatura se a pessoa sair da
  /// equipe — mesma razão do campo `autor` na tela.
  autor      String
  texto      String
  criadaEm   DateTime       @default(now())

  @@index([clienteId])
  @@map("notas_cliente")
}

/// Item do checklist de onboarding, copiado do modelo para cada cliente.
model ItemChecklist {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId String         @db.Uuid
  cliente   Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  grupo     GrupoChecklist
  titulo    String
  descricao String?
  recebido  Boolean        @default(false)
  /// Onde o material foi parar: link do Drive, do Figma, do que for.
  link      String?
  /// Posição no modelo, para o checklist sair sempre na ordem do documento.
  ordem     Int
  updatedAt DateTime       @updatedAt

  @@index([clienteId])
  @@map("itens_checklist")
}

/// Post-it, emoji ou comentário do mural do time. `x` e `y` são porcentagem do
/// quadro, para a posição acompanhar o redimensionamento.
model Anotacao {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo       TipoAnotacao
  x          Float
  y          Float
  texto      String
  cor        CorAnotacao    @default(amarelo)
  autorId    String?        @db.Uuid
  autorFicha Administrador? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autor      String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("anotacoes")
}
